{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrbaron3/servo/contracts/control-store/v1/registration.schema.json",
  "title": "Repository Registration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "repository",
    "enabled",
    "issueMonitorEnabled",
    "prMonitorEnabled",
    "executionEnabled",
    "configuration",
    "version",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "repository": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/(?!\\.{1,2}$)[a-z0-9_.-]{1,100}$"
    },
    "enabled": {
      "type": "boolean"
    },
    "issueMonitorEnabled": {
      "type": "boolean"
    },
    "prMonitorEnabled": {
      "type": "boolean"
    },
    "executionEnabled": {
      "type": "boolean"
    },
    "configuration": {
      "$ref": "#/$defs/historicalRegistrationConfiguration"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "historicalRegistrationConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mergeMethod": {
          "enum": ["squash", "merge", "rebase"],
          "default": "squash"
        },
        "releaseEvidence": {
          "$ref": "#/$defs/historicalReleaseEvidencePolicy"
        },
        "gateTimeoutSeconds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": { "type": "integer", "minimum": 60, "maximum": 2592000 },
            "planning": { "type": "integer", "minimum": 60, "maximum": 2592000 },
            "design": { "type": "integer", "minimum": 60, "maximum": 2592000 },
            "repository-graders": { "type": "integer", "minimum": 60, "maximum": 2592000 },
            "review": { "type": "integer", "minimum": 60, "maximum": 2592000 },
            "merge": { "type": "integer", "minimum": 60, "maximum": 2592000 },
            "lease-recovery": { "type": "integer", "minimum": 60, "maximum": 2592000 }
          }
        }
      }
    },
    "historicalReleaseEvidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "requiredGateSignals",
        "requiredReviewPerspectives",
        "minimumHeadEpochs"
      ],
      "properties": {
        "authority": {
          "enum": ["human-ready-allowed", "ai-triage-required"]
        },
        "requiredGateSignals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "name"],
            "properties": {
              "source": {
                "enum": ["repository-grader", "github-check"]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        },
        "requiredReviewPerspectives": {
          "type": "array",
          "minItems": 2,
          "maxItems": 7,
          "items": {
            "enum": [
              "functionality",
              "codeQuality",
              "testQuality",
              "ux",
              "accessibility",
              "security",
              "type-design"
            ]
          }
        },
        "minimumHeadEpochs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    }
  }
}
